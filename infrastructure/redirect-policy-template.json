{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicWebsiteRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::${bucket}", "arn:aws:s3:::${bucket}/*"]
    },
    {
      "Sid": "ProtectRedirectBucketsFromDeployer",
      "Effect": "Deny",
      "Principal": {"CanonicalUser": "ajeod99ve5lr8iiar1ei"},
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::${bucket}", "arn:aws:s3:::${bucket}/*"]
    },
    {
      "Sid": "ExistingCloudAdministrator",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "ajev28h57merhi7r168p"},
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::${bucket}", "arn:aws:s3:::${bucket}/*"]
    }
  ]
}
